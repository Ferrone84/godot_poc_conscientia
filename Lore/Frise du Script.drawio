        </mxCell>
        <mxCell id="4lUTq4LCrpFsdUCndL-X-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=default;align=center;verticalAlign=middle;rounded=0;" value="Fradiel (33 ans) à son épiphanie quant à la révélation de l&#39;Omnideus&lt;br&gt;&lt;br&gt;Fradiel se confronte à Laurent et le scelle dans le &quot;7&quot;&amp;nbsp;" vertex="1">
          <mxGeometry height="106.03" width="150" x="61" y="632.97" as="geometry" />
        </mxCell>
        <mxCell id="N93kCNNy2wlntK4Qv_rO-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=default;align=center;verticalAlign=middle;rounded=0;" value="Fradiel sauve Céran (4 ans) de l&#39;attaque de l&#39;empire (fomenté en faite par le Duc de Vireille)" vertex="1">
          <mxGeometry height="75" width="150" x="221" y="618" as="geometry" />
        </mxCell>
        <mxCell id="GSEMwH6Rjn52CxEqCu-J-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Fradiel scelle Laurent dans le &quot;7&quot; son palais personnel situé en Pargona. Scellé, Laurent ne peut sortir de son bureau et ne peut interagir avec personne. Ainsi il reste 16 ans&amp;nbsp; isolé de tout dans sa prison dorée parfois visité par une projection de Fradiel.&lt;div&gt;&lt;br&gt;&lt;div&gt;Au courant ces 16 années, Fradiel part à la rencontre de Manon de Simon, de Nicolas, de Lucy et de Céran et leur inculque indirectement la foi en l&#39;Omnideus mais ne leur impose pas pour ne pas rogner leur libertée.&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;En parallèle, privé de leur grand maitre qu&#39;ils savent encore en vie, les Philanthropis voient leur influence diminuer. Aucun nouveau grand maître n&#39;est choisis.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;16 ans plus tard Fradiel redonne la possibilité à Laurent de pouvoir communiqué depuis sa &quot;cellule&quot; mais sans pour autant le libérer du scellement. Fradiel propose un marché à Laurent. Ce dernier obtiendra une partie du pouvoir de Fradiel si celui-ci meurt, cependant s&#39;il veut également être libéré de sa prison il devra faire perdre l&#39;estime et l&#39;amour qu&#39;ont Manon Nicolas Simon Céran et Lucy envers lui sans les tuer. Tout cela selon les voix de l&#39;Omnideus.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Envieux du pouvoir de Fradiel et voulant retrouver sa liberté, Laurent accepte. Il mandate immédiatement les Philanthrope afin de faire condamner Fradiel par l&#39;EE (grâce à ses infiltrés) et demande tout particulièrement à Matthieu de l&#39;executer en cas d&#39;imprévu.&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="326" width="472" x="167" y="1077" as="geometry" />
        </mxCell>
        <mxCell id="GSEMwH6Rjn52CxEqCu-J-4" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="956" y="603" as="sourcePoint" />
            <mxPoint x="956" y="543" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GSEMwH6Rjn52CxEqCu-J-5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="Sur demande de Fradiel Céran et Lucy libèrent d&#39;un camp de prisonnier de l&#39;Empire plusieurs Vaurédien ainsi que leur famille (en réalité des opposant politique du Duc de Vireille que ce dernier faisait exécuter avec l&#39;aide de l&#39;EE)&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;A ce moment Lucy et Céran comprennent que l&#39;EE n&#39;est pas si bienveillant que ce que prône le Grimorest.&lt;/div&gt;" vertex="1">
          <mxGeometry height="235.79" width="150" x="882" y="605.21" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
