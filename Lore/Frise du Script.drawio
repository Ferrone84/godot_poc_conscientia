        <mxCell id="ddPyTFRK7qIsAbKJvkIx-12" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;" value="&lt;font style=&quot;&quot;&gt;Les Voix votent l&#39;exécution de Fradiel en Vaurédie&lt;br&gt;&lt;br&gt;Matthieu interromps l&#39;éxecution pour tuer Fradiel lui même&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;Sans résister il essaye de raisonner ce dernier.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;Céran Tente de sauver Fradiel mais se fait dominer par Matthieu qui le provoque pour qu&#39;il désire la puissance (plan de Laurent)&lt;br&gt;&lt;br&gt;Matthieu achève Fradiel qui profite de cela pour l&#39;étreindre une dernière fois. (Ce qui affectera profondément Matthieu)&amp;nbsp; puis le téléporte loin&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;Lorsque Fradiel meurt, il dit à Céran de sauver Matthieu et de l&#39;amener vers la paix&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
